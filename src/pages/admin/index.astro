---
import SiteFooter from "../../components/SiteFooter.astro";
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>หลังบ้าน | Phonnapa Studio</title>
    <link rel="icon" href="/images/logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600&family=Pridi:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="admin-header">
      <a class="brand" href="/"><img src="/images/logo.webp" alt="" /><span>Phonnapa <i>Studio</i></span></a>
      <div><a href="/" target="_blank">ดูหน้าเว็บ ↗</a><button id="logout" type="button" hidden>ออกจากระบบ</button></div>
    </header>

    <main>
      <section id="setup" class="state-card" hidden>
        <span>SETUP REQUIRED</span><h1>เชื่อมต่อ Supabase ก่อนใช้งาน</h1>
        <p>คัดลอก <code>.env.example</code> เป็น <code>.env</code> แล้วใส่ Project URL และ Publishable key จาก Supabase จากนั้นรันไฟล์ <code>supabase/migrations/001_admin.sql</code> ใน SQL Editor</p>
      </section>

      <section id="login-view" class="login-layout" hidden>
        <div><p class="eyebrow">ADMINISTRATION</p><h1>จัดการข้อมูล<br /><em>Phonnapa Studio</em></h1><p>เข้าสู่ระบบเพื่อแก้ไขราคาบริการและตารางคิวที่แสดงบนหน้าเว็บ</p></div>
        <form id="login-form" class="login-card">
          <p class="eyebrow">ADMIN SIGN IN</p><h2>เข้าสู่ระบบหลังบ้าน</h2>
          <label>อีเมล<input id="email" type="email" autocomplete="username" required /></label>
          <label>รหัสผ่าน<input id="password" type="password" autocomplete="current-password" required /></label>
          <p id="login-error" class="form-error" hidden></p>
          <button type="submit">เข้าสู่ระบบ <span>→</span></button>
        </form>
      </section>

      <section id="admin-view" class="admin-view" hidden>
        <div class="dashboard-heading"><div><p class="eyebrow">ADMIN DASHBOARD</p><h1>จัดการหลังบ้าน</h1></div><div class="dashboard-actions"><p>การแก้ไขจะมีผลกับหน้าเว็บเมื่อกดบันทึก</p><div><a href="https://analytics.google.com/analytics/web/" target="_blank" rel="noopener">Google Analytics ↗</a><a href="https://search.google.com/search-console/" target="_blank" rel="noopener">Search Console ↗</a></div></div></div>
        <nav class="admin-tabs" aria-label="เมนูหลังบ้าน">
          <button class="active" type="button" data-tab="prices">ราคาบริการ</button>
          <button type="button" data-tab="schedule">ตารางคิว</button>
          <button type="button" data-tab="promotions">โปรโมชั่น</button>
        </nav>

        <section id="prices-panel" class="admin-panel">
          <div class="panel-title"><div><p class="eyebrow">SERVICE PRICES</p><h2>ปรับราคาบริการ</h2><p>แก้ไขเฉพาะข้อความราคา เช่น “159 บาท” หรือ “เริ่มต้น 10 บาท/นิ้ว”</p></div><button id="save-prices" class="save-button" type="button">บันทึกราคา</button></div>
          <div id="services-list" class="services-list"><p class="loading">กำลังโหลดบริการ…</p></div>
        </section>

        <section id="schedule-panel" class="admin-panel" hidden>
          <div class="panel-title"><div><p class="eyebrow">TWO-MONTH SCHEDULE</p><h2>ปรับตารางคิว</h2><p>แก้เวลา สถานะ และชื่อลูกค้าได้ล่วงหน้า 2 เดือน โดยชื่อจะแสดงบนหน้าคิวเมื่อเลือกสถานะ “เต็มแล้ว”</p></div><button id="save-schedule" class="save-button" type="button">บันทึกตารางคิว</button></div>
          <div class="schedule-legend"><span><i class="available"></i>ว่างอยู่</span><span><i class="booked"></i>เต็มแล้ว</span><span><i class="holiday"></i>วันหยุด</span></div>
          <div id="schedule-list" class="schedule-list"><p class="loading">กำลังโหลดตารางคิว…</p></div>
        </section>

        <section id="promotions-panel" class="admin-panel" hidden>
          <div class="panel-title"><div><p class="eyebrow">PROMOTION POPUP</p><h2>รูปโปรโมชั่น</h2><p>อัปโหลดได้สูงสุด 10 รูป รูปที่เปิดใช้งานจะแสดงเป็น Popup เมื่อเข้าหน้าเว็บ</p></div></div>
          <form id="promotion-form" class="promotion-form">
            <label>ชื่อโปรโมชั่น<input id="promotion-title" type="text" maxlength="100" placeholder="เช่น โปรโมชั่นเปิดเทอม" /></label>
            <label>เลือกรูปภาพ<input id="promotion-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required /></label>
            <button class="save-button" type="submit">อัปโหลดรูป</button>
          </form>
          <div class="upload-guidance">
            <strong>ขนาดรูปที่แนะนำ 1080 × 1350 px (อัตราส่วน 4:5)</strong>
            <span>รองรับ JPG, PNG, WEBP และ GIF ขนาดไม่เกิน 6 MB · วางข้อความสำคัญห่างจากขอบรูปอย่างน้อย 80 px</span>
          </div>
          <p id="promotion-upload-status" class="upload-status" role="status" aria-live="polite" hidden></p>
          <div id="promotions-list" class="promotions-list"><p class="loading">กำลังโหลดโปรโมชั่น…</p></div>
        </section>

      </section>
    </main>

    <div id="toast" class="toast" role="status" hidden></div>
    <SiteFooter />

    <script>
      import { supabase, isSupabaseConfigured } from "../../lib/supabase";

      const setup = document.getElementById("setup");
      const loginView = document.getElementById("login-view");
      const adminView = document.getElementById("admin-view");
      const logoutButton = document.getElementById("logout");
      const toast = document.getElementById("toast");
      const TIMES = ["09:00", "12:00", "15:00", "18:00"];
      const STATUS_LABELS = { available: "ว่างอยู่", booked: "เต็มแล้ว", holiday: "วันหยุด" };
      let toastTimer;

      function notify(message, error = false) {
        if (!toast) return;
        toast.textContent = message;
        toast.className = `toast${error ? " error" : ""}`;
        toast.hidden = false;
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => { toast.hidden = true; }, 4200);
      }
      function setPromotionStatus(message, state = "") {
        const status = document.getElementById("promotion-upload-status");
        if (!status) return;
        status.textContent = message;
        status.className = `upload-status${state ? ` ${state}` : ""}`;
        status.hidden = !message;
      }
      function toKey(date) {
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
      }
      const dates = Array.from({ length: 60 }, (_, index) => {
        const date = new Date(); date.setHours(12, 0, 0, 0); date.setDate(date.getDate() + index); return date;
      });

      async function showLogin() {
        if (setup) setup.hidden = true;
        if (loginView) loginView.hidden = false;
        if (adminView) adminView.hidden = true;
        if (logoutButton) logoutButton.hidden = true;
      }
      async function showAdmin(userId) {
        if (!supabase) return;
        const { data, error } = await supabase.from("admin_users").select("user_id").eq("user_id", userId).maybeSingle();
        if (error || !data) {
          await supabase.auth.signOut();
          await showLogin();
          const errorEl = document.getElementById("login-error");
          if (errorEl) { errorEl.textContent = "บัญชีนี้ยังไม่ได้รับสิทธิ์ผู้ดูแล"; errorEl.hidden = false; }
          return;
        }
        if (loginView) loginView.hidden = true;
        if (adminView) adminView.hidden = false;
        if (logoutButton) logoutButton.hidden = false;
        await cleanupPastSchedule();
        await Promise.all([loadServices(), loadSchedule(), loadPromotions()]);
      }

      async function cleanupPastSchedule() {
        if (!supabase) return;
        const today = toKey(new Date());
        const { error, count } = await supabase.from("schedule_slots").delete({ count: "exact" }).lt("slot_date", today);
        if (error) notify("ลบข้อมูลคิวเก่าไม่สำเร็จ", true);
        else if ((count || 0) > 0) notify(`ลบคิวก่อนวันนี้แล้ว ${count} รายการ`);
      }

      document.getElementById("login-form")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!supabase) return;
        const email = document.getElementById("email")?.value || "";
        const password = document.getElementById("password")?.value || "";
        const errorEl = document.getElementById("login-error");
        if (errorEl) errorEl.hidden = true;
        const { data, error } = await supabase.auth.signInWithPassword({ email, password });
        if (error || !data.user) {
          if (errorEl) { errorEl.textContent = "อีเมลหรือรหัสผ่านไม่ถูกต้อง"; errorEl.hidden = false; }
          return;
        }
        await showAdmin(data.user.id);
      });
      logoutButton?.addEventListener("click", async () => { await supabase?.auth.signOut(); await showLogin(); });

      document.querySelectorAll("[data-tab]").forEach((button) => button.addEventListener("click", () => {
        const tab = button.getAttribute("data-tab");
        document.querySelectorAll("[data-tab]").forEach((item) => item.classList.toggle("active", item === button));
        const prices = document.getElementById("prices-panel");
        const schedule = document.getElementById("schedule-panel");
        const promotions = document.getElementById("promotions-panel");
        if (prices) prices.hidden = tab !== "prices";
        if (schedule) schedule.hidden = tab !== "schedule";
        if (promotions) promotions.hidden = tab !== "promotions";
      }));

      async function loadServices() {
        if (!supabase) return;
        const list = document.getElementById("services-list");
        const { data, error } = await supabase.from("services").select("slug,name,price,sort_order").order("sort_order");
        if (!list) return;
        if (error) { list.innerHTML = '<p class="form-error">โหลดข้อมูลบริการไม่สำเร็จ</p>'; return; }
        list.innerHTML = "";
        (data || []).forEach((service, index) => {
          const row = document.createElement("label");
          row.className = "service-row";
          row.innerHTML = `<span><small>${String(index + 1).padStart(2, "0")}</small><strong>${service.name}</strong></span><input type="text" value="${String(service.price).replaceAll('"', '&quot;')}" data-price-slug="${service.slug}" aria-label="ราคาของ ${service.name}">`;
          list.appendChild(row);
        });
      }
      document.getElementById("save-prices")?.addEventListener("click", async () => {
        if (!supabase) return;
        const button = document.getElementById("save-prices");
        button.disabled = true;
        const updates = Array.from(document.querySelectorAll("[data-price-slug]")).map((input) =>
          supabase.from("services").update({ price: input.value.trim(), updated_at: new Date().toISOString() }).eq("slug", input.dataset.priceSlug)
        );
        const results = await Promise.all(updates);
        button.disabled = false;
        results.some((result) => result.error) ? notify("บันทึกราคาไม่สำเร็จ", true) : notify("บันทึกราคาเรียบร้อยแล้ว");
      });

      async function loadSchedule() {
        if (!supabase) return;
        const [{ data, error }, { data: customerNames, error: namesError }] = await Promise.all([
          supabase.from("schedule_slots").select("id,slot_date,slot_time,status").gte("slot_date", toKey(dates[0])).lte("slot_date", toKey(dates[dates.length - 1])),
          supabase.from("schedule_slot_notes").select("slot_id,customer_name"),
        ]);
        if (error || namesError) { notify("โหลดตารางคิวไม่สำเร็จ", true); }
        const customerMap = new Map((customerNames || []).map((item) => [String(item.slot_id), item.customer_name || ""]));
        const map = new Map();
        if (!error) (data || []).forEach((slot) => {
          if (!map.has(slot.slot_date)) map.set(slot.slot_date, []);
          map.get(slot.slot_date).push({ ...slot, customer_name: customerMap.get(String(slot.id)) || "" });
        });
        map.forEach((slots) => slots.sort((a, b) => String(a.slot_time).localeCompare(String(b.slot_time))));
        renderSchedule(map);
      }
      function renderSchedule(map) {
        const list = document.getElementById("schedule-list");
        if (!list) return;
        list.innerHTML = "";
        dates.forEach((date) => {
          const key = toKey(date);
          const row = document.createElement("article");
          row.className = "schedule-row";
          row.dataset.date = key;
          const label = date.toLocaleDateString("th-TH", { weekday: "short", day: "numeric", month: "short", year: "numeric" });
          const daySlots = map.get(key) || [];
          row.innerHTML = `<div class="date-cell"><strong>${label}</strong><div><button type="button" data-day-action="available">เปิดทุกคิว</button><button type="button" data-day-action="holiday">วันหยุด</button></div></div><div class="slot-editors">${TIMES.map((defaultTime, index) => { const slot = daySlots[index] || {}; const status = slot.status || "booked"; return `<div class="slot-editor" data-slot-id="${slot.id || ""}" data-slot-date="${key}"><input class="time-input" type="time" value="${String(slot.slot_time || defaultTime).slice(0,5)}" aria-label="เวลา"><select data-slot-status class="${status}">${Object.entries(STATUS_LABELS).map(([value, text]) => `<option value="${value}"${value === status ? " selected" : ""}>${text}</option>`).join("")}</select><input data-customer-name type="text" maxlength="100" placeholder="ชื่อลูกค้า" aria-label="ชื่อลูกค้า" value="${String(slot.customer_name || "").replaceAll('&','&amp;').replaceAll('"','&quot;').replaceAll('<','&lt;').replaceAll('>','&gt;')}"></div>`; }).join("")}</div>`;
          list.appendChild(row);
        });
        list.querySelectorAll("[data-slot-status]").forEach((select) => select.addEventListener("change", () => { select.className = select.value; }));
        list.querySelectorAll("[data-day-action]").forEach((button) => button.addEventListener("click", () => {
          const status = button.dataset.dayAction;
          button.closest(".schedule-row")?.querySelectorAll("[data-slot-status]").forEach((select) => { select.value = status; select.className = status; });
        }));
      }
      document.getElementById("save-schedule")?.addEventListener("click", async () => {
        if (!supabase) return;
        const button = document.getElementById("save-schedule");
        button.disabled = true;
        const editors = Array.from(document.querySelectorAll(".slot-editor")).map((editor) => ({
          element: editor, id: editor.dataset.slotId ? Number(editor.dataset.slotId) : null,
          slot_date: editor.dataset.slotDate, slot_time: `${editor.querySelector(".time-input").value}:00`,
          status: editor.querySelector("[data-slot-status]").value,
          customer_name: editor.querySelector("[data-customer-name]").value.trim(),
        }));
        const existing = editors.filter((row) => row.id).map(({ id, slot_date, slot_time, status }) => ({ id, slot_date, slot_time, status, updated_at: new Date().toISOString() }));
        const fresh = editors.filter((row) => !row.id).map(({ slot_date, slot_time, status }) => ({ slot_date, slot_time, status, updated_at: new Date().toISOString() }));
        const results = [];
        if (existing.length) results.push(await supabase.from("schedule_slots").upsert(existing, { onConflict: "id" }).select("id,slot_date,slot_time"));
        if (fresh.length) results.push(await supabase.from("schedule_slots").insert(fresh).select("id,slot_date,slot_time"));
        const error = results.find((result) => result.error)?.error;
        if (!error) {
          const savedSlots = results.flatMap((result) => result.data || []);
          const customerNames = savedSlots.map((slot) => {
            const editor = editors.find((item) => item.slot_date === slot.slot_date && item.slot_time.slice(0,5) === String(slot.slot_time).slice(0,5));
            return { slot_id: slot.id, customer_name: editor?.customer_name || "", updated_at: new Date().toISOString() };
          });
          if (customerNames.length) {
            const nameResult = await supabase.from("schedule_slot_notes").upsert(customerNames, { onConflict: "slot_id" });
            if (nameResult.error) results.push(nameResult);
          }
        }
        button.disabled = false;
        results.some((result) => result.error) ? notify("บันทึกตารางคิวไม่สำเร็จ กรุณาตรวจเวลาซ้ำ", true) : (notify("บันทึกตารางคิวเรียบร้อยแล้ว"), await loadSchedule());
      });

      async function loadPromotions() {
        if (!supabase) return;
        const list = document.getElementById("promotions-list");
        const { data, error } = await supabase.from("promotions").select("id,title,image_url,storage_path,active,sort_order").order("sort_order");
        if (!list) return;
        if (error) { list.innerHTML = '<p class="form-error">โหลดโปรโมชั่นไม่สำเร็จ</p>'; return; }
        list.dataset.count = String(data?.length || 0);
        list.innerHTML = data?.length ? "" : '<p class="loading">ยังไม่มีรูปโปรโมชั่น</p>';
        (data || []).forEach((promotion, index) => {
          const card = document.createElement("article");
          card.className = "promotion-card";
          card.innerHTML = `<img src="${promotion.image_url}" alt=""><div><strong>${promotion.title || `โปรโมชั่น ${index + 1}`}</strong><label><input type="checkbox" data-promotion-active="${promotion.id}"${promotion.active ? " checked" : ""}> แสดง Popup</label><button type="button" data-delete-promotion="${promotion.id}" data-storage-path="${promotion.storage_path}">ลบรูป</button></div>`;
          list.appendChild(card);
        });
        list.querySelectorAll("[data-promotion-active]").forEach((input) => input.addEventListener("change", async () => {
          const { error } = await supabase.from("promotions").update({ active: input.checked }).eq("id", input.dataset.promotionActive);
          error ? notify("เปลี่ยนสถานะไม่สำเร็จ", true) : notify("เปลี่ยนสถานะโปรโมชั่นแล้ว");
        }));
        list.querySelectorAll("[data-delete-promotion]").forEach((button) => button.addEventListener("click", async () => {
          if (!confirm("ลบรูปโปรโมชั่นนี้ใช่ไหม?")) return;
          const storagePath = button.dataset.storagePath;
          const [{ error: fileError }, { error: rowError }] = await Promise.all([
            supabase.storage.from("promotions").remove([storagePath]),
            supabase.from("promotions").delete().eq("id", button.dataset.deletePromotion),
          ]);
          fileError || rowError ? notify("ลบโปรโมชั่นไม่สำเร็จ", true) : (notify("ลบโปรโมชั่นแล้ว"), await loadPromotions());
        }));
      }
      document.getElementById("promotion-form")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!supabase) return;
        const list = document.getElementById("promotions-list");
        if (Number(list?.dataset.count || 0) >= 10) { notify("อัปโหลดได้สูงสุด 10 รูป", true); return; }
        const fileInput = document.getElementById("promotion-file");
        const file = fileInput?.files?.[0];
        if (!file) { setPromotionStatus("กรุณาเลือกรูปที่ต้องการอัปโหลด", "error"); return; }
        if (file.size > 6 * 1024 * 1024) { setPromotionStatus("ไฟล์ต้องมีขนาดไม่เกิน 6 MB", "error"); notify("ไฟล์ต้องมีขนาดไม่เกิน 6 MB", true); return; }
        const submit = event.currentTarget.querySelector("button[type=submit]");
        const originalLabel = submit.textContent;
        submit.disabled = true;
        submit.textContent = "กำลังอัปโหลด…";
        setPromotionStatus("กำลังอัปโหลดและบันทึกรูป กรุณารอสักครู่…", "loading");
        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, "-");
        const path = `${Date.now()}-${safeName}`;
        const { error: uploadError } = await supabase.storage.from("promotions").upload(path, file, { contentType: file.type });
        if (uploadError) { submit.disabled = false; submit.textContent = originalLabel; setPromotionStatus(`อัปโหลดไม่สำเร็จ: ${uploadError.message}`, "error"); notify("อัปโหลดรูปไม่สำเร็จ", true); return; }
        const { data: urlData } = supabase.storage.from("promotions").getPublicUrl(path);
        const title = document.getElementById("promotion-title")?.value.trim() || "";
        const { data: createdPromotion, error } = await supabase.from("promotions").insert({ title, image_url: urlData.publicUrl, storage_path: path, active: true, sort_order: Number(list?.dataset.count || 0) }).select("id,title,image_url,storage_path,active,sort_order").single();
        submit.disabled = false;
        submit.textContent = originalLabel;
        if (error) { await supabase.storage.from("promotions").remove([path]); setPromotionStatus(`บันทึกไม่สำเร็จ: ${error.message}`, "error"); notify("บันทึกโปรโมชั่นไม่สำเร็จ", true); return; }
        event.currentTarget.reset();
        setPromotionStatus("อัปโหลดสำเร็จแล้ว รูปนี้เปิดแสดงบนหน้าเว็บเรียบร้อย ✓", "success");
        notify("อัปโหลดรูปโปรโมชั่นสำเร็จแล้ว ✓");
        await loadPromotions();
        const uploadedCard = createdPromotion ? document.querySelector(`[data-promotion-active="${createdPromotion.id}"]`)?.closest(".promotion-card") : null;
        uploadedCard?.classList.add("just-uploaded");
        document.getElementById("promotion-upload-status")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });

      async function boot() {
        if (!isSupabaseConfigured || !supabase) { if (setup) setup.hidden = false; return; }
        const { data } = await supabase.auth.getSession();
        data.session?.user ? await showAdmin(data.session.user.id) : await showLogin();
      }
      boot();
    </script>
  </body>
</html>

<style is:global>
  :root { --ink:#30292c; --plum:#765463; --wine:#694553; --paper:#f9f5f4; --blush:#efe3e5; --line:#ddd3d4; --muted:#746b6e; --green:#5d8a6a; --red:#a55d65; --gold:#b88943; }
