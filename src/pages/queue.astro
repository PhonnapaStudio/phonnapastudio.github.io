---
import SiteFooter from "../components/SiteFooter.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import BrandLogo from "../components/BrandLogo.astro";
import OptimizedPicture from "../components/OptimizedPicture.astro";
import FontPreloads from "../components/FontPreloads.astro";
import SecurityMeta from "../components/SecurityMeta.astro";
import "../styles/fonts.css";
import assets from "../data/assets.generated.json";

const base = import.meta.env.BASE_URL || "/";
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SecurityMeta />
    <FontPreloads />
    <GoogleAnalytics />
    <title>ตารางคิวว่างร้านทำเล็บคลองหก คลอง 6 | Phonnapa Studio</title>
    <meta name="description" content="เช็กตารางคิวว่าง Phonnapa Studio ร้านทำเล็บคลองหก คลอง 6 ใกล้ มทร.ธัญบุรี ดูเวลาว่างล่วงหน้าแล้วติดต่อร้านผ่าน LINE เพื่อยืนยันคิว" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://phonnapastudio.github.io/queue/" />
    <link rel="icon" href={assets.logo.sources.webp[0].src} />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="กลับหน้าแรก Phonnapa Studio">
        <BrandLogo alt="โลโก้ Phonnapa Studio" />
        <span>Phonnapa <i>Studio</i></span>
      </a>
      <a class="back-link" href={base}><span>←</span> กลับหน้าแรก</a>
    </header>

    <main>
      <section class="intro">
        <article class="lofi-card hero-lofi">
          <picture aria-hidden="true">
            <source media="(prefers-reduced-motion: reduce)" srcset="/images/cover.webp" />
            <source media="(max-width: 680px)" srcset="/images/lofi-bg-mobile.gif" />
            <img src="/images/lofi-bg-desktop.gif" alt="" width="1200" height="736" decoding="async" fetchpriority="low" />
          </picture>
          <div class="lofi-overlay">
            <div class="hero-gif-copy">
              <p class="eyebrow">QUEUE AVAILABILITY</p>
              <h1>เช็กวันและเวลา<br /><em>คิวว่างของเรา</em></h1>
              <p class="intro-copy">ตรวจสอบคิวว่างร้านทำเล็บคลอง 6 เบื้องต้น แล้วทัก LINE เพื่อให้ทางร้านยืนยันคิวอีกครั้งค่ะ</p>
            </div>
            <button id="lofi-toggle" class="lofi-toggle" type="button" aria-pressed="false" aria-label="ปิดเพลงบรรยากาศ">
              <OptimizedPicture asset={assets.album} alt="" sizes="38px" loading="eager" fetchpriority="low" />
              <span class="music-icon">Ⅱ</span>
              <span class="music-label">พักเพลง</span>
            </button>
          </div>
          <audio id="lofi-audio" preload="none" autoplay loop data-src="/audio/lofi.mp3"></audio>
        </article>
      </section>

      <section class="queue-layout">
        <div class="calendar-panel">
          <div class="panel-heading">
            <div><p class="eyebrow">CURRENT SCHEDULE</p><h2>ตารางคิวล่าสุด</h2></div>
            <p class="canva-hint">อัปเดตตารางโดย Phonnapa Studio</p>
          </div>

          <div class="canva-embed">
            <iframe
              loading="lazy"
              title="ตารางคิว Phonnapa Studio"
              src="https://www.canva.com/design/DAGiIXfWkYw/0K-nPNNZhs_lWNUMRr-o8g/view?embed"
              allowfullscreen
              allow="fullscreen"
            ></iframe>
          </div>
          <a class="canva-link" href="https://www.canva.com/design/DAGiIXfWkYw/0K-nPNNZhs_lWNUMRr-o8g/view?utm_content=DAGiIXfWkYw&amp;utm_campaign=designshare&amp;utm_medium=embeds&amp;utm_source=link" target="_blank" rel="noopener">เปิดตารางคิวแบบเต็มหน้าจอ <span>↗</span></a>
        </div>

        <aside class="sidebar">
          <article class="contact-card">
            <p class="eyebrow">HOW TO BOOK</p>
            <h2>พบคิวที่สะดวกแล้ว?</h2>
            <p>ส่งวันที่และช่วงเวลาที่ต้องการมาทาง LINE ทางร้านจะตรวจสอบและยืนยันคิวให้ค่ะ</p>
            <ol>
              <li><span>01</span><div><strong>เช็กวันและเวลาว่าง</strong><p>ดูสถานะล่าสุดจากตารางด้านข้าง</p></div></li>
              <li><span>02</span><div><strong>แจ้งร้านผ่าน LINE</strong><p>ส่งวันที่ เวลา และบริการที่สนใจ</p></div></li>
              <li><span>03</span><div><strong>รอร้านยืนยันคิว</strong><p>ถือว่าจองสำเร็จเมื่อร้านตอบยืนยันแล้ว</p></div></li>
            </ol>
            <a class="line-button" href="https://line.me/R/ti/p/@153nuymp" target="_blank" rel="noopener">สอบถามและจองผ่าน LINE <span>↗</span></a>
          </article>

          <article class="important-card">
            <p class="eyebrow">PLEASE NOTE</p>
            <h3>เงื่อนไขการจองคิว</h3>
            <div class="note-list">
              <p>หากต้องการต่อเล็บ PVC เพ้นท์ลายเยอะ ๆ จึ้ง ๆ รบกวนลูกค้าจองคิวที่มีว่างติดกัน 2 คิวนะคะ</p>
              <p>ในการจองคิวทางร้านจะขออนุญาตเก็บมัดจำล็อกคิว คิวละ 100.- ส่วนต่างชำระหน้างานอีกทีค่ะ</p>
              <p class="deposit">มัดจำ = ได้คิว</p>
              <p>จองแล้วรบกวนลูกค้ามาตรงเวลานัดนะคะ เลทได้ไม่เกิน 15 นาที</p>
              <p>กรณีเลื่อน สามารถเลื่อนได้ 1 ครั้ง / กรณียกเลิก = ยึดมัดจำ</p>
            </div>
          </article>
        </aside>
      </section>

      <section class="help">
        <div><p class="eyebrow">NEED HELP?</p><h2>ดูตารางไม่ได้หรือต้องการสอบถาม?</h2><p>ติดต่อร้านโดยตรงได้ทุกวัน เวลา 09:00–21:00 น.</p></div>
        <div class="help-links"><a href="https://line.me/R/ti/p/@153nuymp" target="_blank" rel="noopener"><span>LINE</span><strong>@153nuymp</strong></a><a href="tel:0956658550"><span>โทร</span><strong>095-665-8550</strong></a></div>
      </section>
    </main>

    <SiteFooter />
    <a class="mobile-line" href="https://line.me/R/ti/p/@153nuymp" target="_blank" rel="noopener">ติดต่อร้านผ่าน LINE</a>

    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        const lofiAudio = document.getElementById("lofi-audio");
        const lofiToggle = document.getElementById("lofi-toggle");
        const musicIcon = lofiToggle?.querySelector(".music-icon");
        const musicLabel = lofiToggle?.querySelector(".music-label");
        function prepareAudio() {
          if (!(lofiAudio instanceof HTMLAudioElement) || lofiAudio.src) return;
          lofiAudio.src = lofiAudio.dataset.src || "";
          lofiAudio.load();
        }
        function syncMusicUI(playing) {
          lofiToggle?.classList.toggle("playing", playing);
          lofiToggle?.setAttribute("aria-pressed", String(playing));
          lofiToggle?.setAttribute("aria-label", playing ? "พักเพลงบรรยากาศ" : "เปิดเพลงบรรยากาศ");
          if (musicIcon) musicIcon.textContent = playing ? "Ⅱ" : "▶";
          if (musicLabel) musicLabel.textContent = playing ? "พักเพลง" : "เปิดเพลง";
        }
        lofiToggle?.addEventListener("click", async () => {
          if (!(lofiAudio instanceof HTMLAudioElement)) return;
          if (lofiAudio.paused) {
            prepareAudio();
            try { await lofiAudio.play(); syncMusicUI(true); }
            catch { syncMusicUI(false); }
          } else { lofiAudio.pause(); syncMusicUI(false); }
        });
        lofiAudio?.addEventListener("play", () => syncMusicUI(true));
        lofiAudio?.addEventListener("pause", () => syncMusicUI(false));

        async function startMusicAutomatically() {
          if (!(lofiAudio instanceof HTMLAudioElement)) return;
          if (navigator.connection?.saveData) { syncMusicUI(false); return; }
          try {
            prepareAudio();
            lofiAudio.muted = true;
            await lofiAudio.play();
            syncMusicUI(true);
            window.setTimeout(() => { lofiAudio.muted = false; }, 250);
          } catch {
            lofiAudio.muted = false;
            syncMusicUI(false);
          }
        }
        const scheduleMusic = () => window.setTimeout(startMusicAutomatically, 1200);
        if (document.readyState === "complete") scheduleMusic();
        else window.addEventListener("load", scheduleMusic, { once: true });
      });
    </script>
  </body>
</html>

<style is:global>
  :root { --ink:#30292c; --plum:#765463; --wine:#694553; --paper:#f9f5f4; --blush:#efe3e5; --line:#ddd3d4; --muted:#746b6e; --green:#5d8a6a; --green-bg:#e7f0e9; --red:#a55d65; --red-bg:#f2e6e8; --gold:#b88943; --gold-bg:#f5eddf; --gray-bg:#eee9ea; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--paper); color:var(--ink); font-family:"IBM Plex Sans Thai","Noto Sans Thai",Tahoma,sans-serif; font-weight:400; line-height:1.65; }
  a { color:inherit; text-decoration:none; } img { display:block; width:100%; } h1,h2,h3,p { margin-top:0; }
  h1,h2,h3,.brand { font-family:"Pridi",serif; font-weight:500; }
  .site-header { height:82px; display:flex; align-items:center; justify-content:space-between; padding:0 clamp(24px,6vw,92px); border-bottom:1px solid rgba(105,69,83,.1); background:rgba(249,245,244,.95); }
  .brand { display:flex; align-items:center; gap:12px; font-size:1.1rem; } .brand img { width:34px; height:34px; border-radius:50%; object-fit:cover; filter:grayscale(1); } .brand i { color:var(--plum); font-style:normal; }
  .back-link { color:var(--plum); font-size:.7rem; font-weight:600; text-transform:uppercase; letter-spacing:.12em; }
  .intro { padding:55px clamp(24px,7vw,110px); border-bottom:1px solid var(--line); }
  .eyebrow { color:var(--plum); font-size:.62rem; font-weight:600; letter-spacing:.22em; text-transform:uppercase; margin-bottom:16px; }
  .intro h1 { color:white; font-size:clamp(3rem,6vw,5.5rem); line-height:.98; letter-spacing:-.04em; margin-bottom:28px; } .intro h1 em { color:#ead5dc; font-weight:400; }
  .intro-copy { max-width:600px; color:#eadfe2; font-size:1rem; }
  .queue-layout { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(300px,.65fr); gap:42px; padding:80px clamp(24px,7vw,110px) 100px; align-items:start; }
  .calendar-panel { min-width:0; }
  .panel-heading { display:flex; justify-content:space-between; align-items:end; gap:30px; margin-bottom:25px; }
  .panel-heading .eyebrow { margin-bottom:8px; } .panel-heading h2 { font-size:2.2rem; margin:0; }
  .canva-hint { margin:0 0 6px; color:var(--muted); font-size:.72rem; }
  .canva-embed { position:relative; width:100%; aspect-ratio:5 / 7; overflow:hidden; border:1px solid var(--line); border-radius:12px; background:#fffdfc; box-shadow:0 12px 32px rgba(63,69,81,.14); }
  .canva-embed iframe { position:absolute; inset:0; width:100%; height:100%; border:0; padding:0; margin:0; }
  .canva-link { display:inline-flex; align-items:center; gap:9px; margin-top:17px; color:var(--wine); font-size:.72rem; font-weight:600; letter-spacing:.04em; }
  .canva-link span { transition:transform .2s; } .canva-link:hover span { transform:translate(2px,-2px); }
  .sidebar { display:grid; gap:20px; }
  .contact-card,.important-card { padding:36px; background:#fffdfc; border:1px solid var(--line); }
  .contact-card h2 { font-size:1.75rem; margin-bottom:12px; } .contact-card>p:not(.eyebrow) { color:var(--muted); font-size:.82rem; }
  .contact-card ol { list-style:none; padding:8px 0 0; margin:0; }
  .contact-card li { display:flex; gap:15px; padding:15px 0; border-bottom:1px solid var(--line); }
  .contact-card li>span { color:var(--plum); font:500 .72rem "Pridi",serif; } .contact-card li strong { display:block; font-size:.78rem; } .contact-card li p { margin:2px 0 0; color:var(--muted); font-size:.7rem; }
  .line-button { margin-top:26px; padding:13px 20px; display:flex; justify-content:center; gap:15px; color:white; background:var(--wine); text-transform:uppercase; letter-spacing:.1em; font-size:.65rem; font-weight:600; transition:.25s; } .line-button:hover { background:#4f323d; }
  .lofi-card { position:relative; min-height:330px; overflow:hidden; background:#2e272a; color:white; }
  .hero-lofi { width:100%; height:540px; min-height:540px; box-shadow:0 22px 55px rgba(56,38,45,.16); }
  .hero-lofi::after { background:linear-gradient(90deg,rgba(30,22,26,.88) 0%,rgba(30,22,26,.62) 48%,rgba(30,22,26,.12) 78%),linear-gradient(0deg,rgba(30,22,26,.5),transparent 55%); }
  .lofi-card>picture,.lofi-card>picture img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .lofi-card>picture img { filter:saturate(.7) brightness(.68); }
  .lofi-card::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(35,27,31,.08),rgba(35,27,31,.86)); }
  .lofi-overlay { position:relative; z-index:1; min-height:100%; height:100%; padding:clamp(34px,5vw,70px); display:flex; flex-direction:column; justify-content:space-between; align-items:flex-start; }
  .hero-gif-copy { max-width:720px; }
  .hero-gif-copy .eyebrow { color:#ead5dc; }
  .lofi-overlay .eyebrow { color:#ead9df; margin-bottom:10px; } .lofi-overlay h3 { font-size:1.65rem; line-height:1.25; margin-bottom:8px; }
  .lofi-overlay>div>p:last-child { max-width:260px; color:#e1d5d9; font-size:.73rem; }
  .lofi-toggle { align-self:flex-start; display:grid; grid-template-columns:38px 20px auto; gap:10px; align-items:center; padding:8px 16px 8px 8px; border:1px solid rgba(255,255,255,.45); border-radius:30px; background:rgba(255,255,255,.13); color:white; backdrop-filter:blur(8px); cursor:pointer; }
  .lofi-toggle>picture,.lofi-toggle>picture img { display:block; width:38px; height:38px; border-radius:50%; object-fit:cover; }
  .lofi-toggle .music-icon { font-size:.72rem; } .lofi-toggle .music-label { font-size:.66rem; font-weight:600; letter-spacing:.08em; }
  .lofi-toggle.playing>picture { animation:disc-spin 6s linear infinite; } .lofi-toggle:hover { background:rgba(255,255,255,.22); }
  @keyframes disc-spin { to { transform:rotate(360deg); } }
  @media (prefers-reduced-motion:reduce) { .lofi-toggle.playing>picture { animation:none; } }
  .important-card h3 { font-size:1.35rem; margin-bottom:14px; }
  .note-list p { padding:11px 0; margin:0; border-bottom:1px solid var(--line); color:var(--muted); font-size:.75rem; }
  .note-list .deposit { margin:12px 0; padding:11px; border:1px solid #dbc5cc; background:var(--blush); color:var(--wine); text-align:center; font-size:.82rem; font-weight:600; letter-spacing:.08em; }
  .help { display:flex; justify-content:space-between; gap:50px; align-items:center; padding:70px clamp(24px,7vw,110px); background:#fffdfc; border-top:1px solid var(--line); }
  .help h2 { font-size:2rem; margin-bottom:5px; } .help>div>p:last-child { color:var(--muted); font-size:.8rem; }
  .help-links { display:flex; gap:14px; } .help-links a { min-width:210px; padding:20px; border:1px solid var(--line); display:flex; flex-direction:column; } .help-links span { color:var(--plum); font-size:.58rem; letter-spacing:.15em; } .help-links strong { font-size:.82rem; margin-top:3px; }
  footer { display:flex; justify-content:space-between; gap:20px; padding:28px clamp(24px,7vw,110px); color:#978a8f; background:#292326; font-size:.62rem; }
  .mobile-line { display:none; }

  @media (max-width:980px) {
    .hero-lofi { height:500px; min-height:500px; }
    .queue-layout { grid-template-columns:1fr; } .sidebar { grid-template-columns:1fr 1fr; } .contact-card { grid-row:auto; }
    .help { align-items:flex-start; } .help-links { flex-direction:column; }
  }
  @media (max-width:680px) {
    body { padding-bottom:62px; } .site-header { height:70px; padding:0 20px; } .back-link { font-size:.6rem; } .brand span { font-size:.95rem; }
    .intro { padding:22px 16px 35px; } .intro h1 { font-size:clamp(2.7rem,13vw,4rem); } .intro-copy { font-size:.86rem; } .hero-lofi { height:510px; min-height:510px; } .hero-lofi::after { background:linear-gradient(180deg,rgba(30,22,26,.22),rgba(30,22,26,.88)); }
    .queue-layout { padding:55px 16px 65px; gap:32px; } .panel-heading { display:block; } .panel-heading h2 { font-size:1.8rem; } .canva-hint { margin-top:8px; }
    .canva-embed { border-radius:8px; }
    .sidebar { grid-template-columns:1fr; } .contact-card { grid-row:auto; padding:30px 25px; } .important-card { padding:28px 25px; } .lofi-card,.lofi-overlay { min-height:320px; }
    .help { display:block; padding:55px 22px; } .help-links { margin-top:28px; } .help-links a { min-width:0; }
    footer { display:block; text-align:center; } footer span { display:block; margin:4px; }
    .mobile-line { display:block; position:fixed; z-index:30; left:0; right:0; bottom:0; padding:14px; background:var(--wine); color:white; text-align:center; font-size:.72rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; }
  }
</style>
