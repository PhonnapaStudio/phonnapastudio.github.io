---
import SiteFooter from "../components/SiteFooter.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

const SHEET_CSV_URL =
  "https://docs.google.com/spreadsheets/d/e/2PACX-1vT6xkgqP_QRVKYf5OhLuLI7eIxCADsnDoX5keC-vAat_YmeAF7_fH6nwOAvW6vASS-tq7ysV5ZnqwYn/pub?gid=0&single=true&output=csv";
const base = import.meta.env.BASE_URL || "/";
const publicSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || "";
const publicSupabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";
---

<!doctype html>
<html lang="th">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ตารางคิวว่างร้านทำเล็บคลองหก คลอง 6 | Phonnapa Studio</title>
    <meta name="description" content="เช็กตารางคิวว่าง Phonnapa Studio ร้านทำเล็บคลองหก คลอง 6 ใกล้ มทร.ธัญบุรี ดูเวลาว่างล่วงหน้าแล้วติดต่อร้านผ่าน LINE เพื่อยืนยันคิว" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://phonnapastudio.github.io/queue/" />
    <link rel="icon" href="/images/logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600&family=Pridi:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="กลับหน้าแรก Phonnapa Studio">
        <img src="/images/logo.webp" alt="โลโก้ Phonnapa Studio" />
        <span>Phonnapa <i>Studio</i></span>
      </a>
      <a class="back-link" href={base}><span>←</span> กลับหน้าแรก</a>
    </header>

    <main>
      <section class="intro">
        <article class="lofi-card hero-lofi">
          <picture aria-hidden="true">
            <source media="(prefers-reduced-motion: reduce)" srcset="/images/cover.webp" />
            <source media="(max-width: 680px)" srcset="/images/lofi-bg-mobile.gif" />
            <img src="/images/lofi-bg-desktop.gif" alt="" />
          </picture>
          <div class="lofi-overlay">
            <div class="hero-gif-copy">
              <p class="eyebrow">QUEUE AVAILABILITY</p>
              <h1>เช็กวันและเวลา<br /><em>คิวว่างของเรา</em></h1>
              <p class="intro-copy">ตรวจสอบคิวว่างร้านทำเล็บคลอง 6 เบื้องต้น แล้วทัก LINE เพื่อให้ทางร้านยืนยันคิวอีกครั้งค่ะ</p>
            </div>
            <button id="lofi-toggle" class="lofi-toggle" type="button" aria-pressed="false" aria-label="ปิดเพลงบรรยากาศ">
              <img src="/images/album.jpg" alt="" />
              <span class="music-icon">Ⅱ</span>
              <span class="music-label">พักเพลง</span>
            </button>
          </div>
          <audio id="lofi-audio" preload="auto" autoplay loop><source src="/audio/lofi.mp3" type="audio/mpeg" /></audio>
        </article>
      </section>

      <section class="queue-layout">
        <div class="calendar-panel">
          <div class="panel-heading">
            <div><p class="eyebrow">CURRENT SCHEDULE</p><h2>ตารางคิวล่าสุด</h2></div>
            <div class="legend" aria-label="คำอธิบายสถานะคิว">
              <span><i class="dot available"></i>คิวว่าง</span>
              <span><i class="dot booked"></i>เต็มแล้ว</span>
              <span><i class="dot holiday"></i>วันหยุด</span>
            </div>
          </div>


          <div id="schedule" class="schedule" data-sheet-url={SHEET_CSV_URL} data-supabase-url={publicSupabaseUrl} data-supabase-key={publicSupabaseKey}>
            <div class="date-nav">
              <button id="date-prev" type="button" aria-label="เลื่อนวันย้อนหลัง">←</button>
              <div id="date-strip" class="date-strip" aria-label="เลือกวันที่ล่วงหน้า 2 เดือน"></div>
              <button id="date-next" type="button" aria-label="เลื่อนวันถัดไป">→</button>
            </div>

            <div class="selected-day">
              <div><p class="selected-label">คิวประจำวันที่</p><h3 id="selected-date">—</h3></div>
              <span id="selected-status" class="day-status">กำลังโหลด</span>
            </div>

            <div id="slot-grid" class="slot-grid" aria-live="polite"></div>
            <div id="calendar-loading" class="calendar-message">กำลังโหลดตารางคิว…</div>
            <div id="calendar-error" class="calendar-error" hidden>ไม่สามารถโหลดข้อมูลล่าสุดได้ ขณะนี้จะแสดงทุกช่วงเวลาเป็น “เต็มแล้ว” เพื่อป้องกันข้อมูลคลาดเคลื่อน กรุณาติดต่อร้านทาง LINE</div>
          </div>
          <p class="updated">ข้อมูลจากตารางของร้าน · รีเฟรชอัตโนมัติทุก 7 นาที</p>
        </div>

        <aside class="sidebar">
          <article class="contact-card">
            <p class="eyebrow">HOW TO BOOK</p>
            <h2>พบคิวที่สะดวกแล้ว?</h2>
            <p>ส่งวันที่และช่วงเวลาที่ต้องการมาทาง LINE ทางร้านจะตรวจสอบและยืนยันคิวให้ค่ะ</p>
            <ol>
              <li><span>01</span><div><strong>เช็กวันและเวลาว่าง</strong><p>ดูสถานะล่าสุดจากตารางด้านข้าง</p></div></li>
              <li><span>02</span><div><strong>แจ้งร้านผ่าน LINE</strong><p>ส่งวันที่ เวลา และบริการที่สนใจ</p></div></li>
              <li><span>03</span><div><strong>รอร้านยืนยันคิว</strong><p>ถือว่าจองสำเร็จเมื่อร้านตอบยืนยันแล้ว</p></div></li>
            </ol>
            <a class="line-button" href="https://line.me/R/ti/p/@153nuymp" target="_blank" rel="noopener">สอบถามและจองผ่าน LINE <span>↗</span></a>
          </article>

          <article class="important-card">
            <p class="eyebrow">PLEASE NOTE</p>
            <h3>เงื่อนไขการจองคิว</h3>
            <div class="note-list">
              <p>หากต้องการต่อเล็บ PVC เพ้นท์ลายเยอะ ๆ จึ้ง ๆ รบกวนลูกค้าจองคิวที่มีว่างติดกัน 2 คิวนะคะ</p>
              <p>ในการจองคิวทางร้านจะขออนุญาตเก็บมัดจำล็อกคิว คิวละ 100.- ส่วนต่างชำระหน้างานอีกทีค่ะ</p>
              <p class="deposit">มัดจำ = ได้คิว</p>
              <p>จองแล้วรบกวนลูกค้ามาตรงเวลานัดนะคะ เลทได้ไม่เกิน 15 นาที</p>
              <p>กรณีเลื่อน สามารถเลื่อนได้ 1 ครั้ง / กรณียกเลิก = ยึดมัดจำ</p>
            </div>
          </article>
        </aside>
      </section>

      <section class="help">
        <div><p class="eyebrow">NEED HELP?</p><h2>ดูตารางไม่ได้หรือต้องการสอบถาม?</h2><p>ติดต่อร้านโดยตรงได้ทุกวัน เวลา 09:00–21:00 น.</p></div>
        <div class="help-links"><a href="https://line.me/R/ti/p/@153nuymp" target="_blank" rel="noopener"><span>LINE</span><strong>@153nuymp</strong></a><a href="tel:0956658550"><span>โทร</span><strong>095-665-8550</strong></a></div>
      </section>
    </main>

    <SiteFooter />
    <a class="mobile-line" href="https://line.me/R/ti/p/@153nuymp" target="_blank" rel="noopener">ติดต่อร้านผ่าน LINE</a>

    <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js" is:raw></script>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        const scheduleEl = document.getElementById("schedule");
        const dateStrip = document.getElementById("date-strip");
        const slotGrid = document.getElementById("slot-grid");
        const selectedDateEl = document.getElementById("selected-date");
        const selectedStatusEl = document.getElementById("selected-status");
        const loadingEl = document.getElementById("calendar-loading");
        const errorEl = document.getElementById("calendar-error");
        const Papa = window.Papa;

        const lofiAudio = document.getElementById("lofi-audio");
        const lofiToggle = document.getElementById("lofi-toggle");
        const musicIcon = lofiToggle?.querySelector(".music-icon");
        const musicLabel = lofiToggle?.querySelector(".music-label");
        function syncMusicUI(playing) {
          lofiToggle?.classList.toggle("playing", playing);
          lofiToggle?.setAttribute("aria-pressed", String(playing));
          lofiToggle?.setAttribute("aria-label", playing ? "พักเพลงบรรยากาศ" : "เปิดเพลงบรรยากาศ");
          if (musicIcon) musicIcon.textContent = playing ? "Ⅱ" : "▶";
          if (musicLabel) musicLabel.textContent = playing ? "พักเพลง" : "เปิดเพลง";
        }
        lofiToggle?.addEventListener("click", async () => {
          if (!(lofiAudio instanceof HTMLAudioElement)) return;
          if (lofiAudio.paused) {
            try { await lofiAudio.play(); syncMusicUI(true); }
            catch { syncMusicUI(false); }
          } else { lofiAudio.pause(); syncMusicUI(false); }
        });
        lofiAudio?.addEventListener("play", () => syncMusicUI(true));
        lofiAudio?.addEventListener("pause", () => syncMusicUI(false));

        async function startMusicAutomatically() {
          if (!(lofiAudio instanceof HTMLAudioElement)) return;
          try {
            lofiAudio.muted = true;
            await lofiAudio.play();
            syncMusicUI(true);
            window.setTimeout(() => { lofiAudio.muted = false; }, 250);
          } catch {
            lofiAudio.muted = false;
            syncMusicUI(false);
          }
        }
        startMusicAutomatically();

        if (!scheduleEl || !dateStrip || !slotGrid) {
          if (loadingEl) loadingEl.hidden = true;
          if (errorEl) errorEl.hidden = false;
          return;
        }

        const TIMES = ["09:00", "12:00", "15:00", "18:00"];
        const DAY_NAMES = ["อา.", "จ.", "อ.", "พ.", "พฤ.", "ศ.", "ส."];
        const MONTH_NAMES = ["ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."];
        const dates = Array.from({ length: 60 }, (_, index) => {
          const date = new Date();
          date.setHours(12, 0, 0, 0);
          date.setDate(date.getDate() + index);
          return date;
        });
        let schedule = new Map();
        let selectedKey = toKey(dates[0]);

        function toKey(date) {
          const year = date.getFullYear();
          const month = String(date.getMonth() + 1).padStart(2, "0");
          const day = String(date.getDate()).padStart(2, "0");
          return `${year}-${month}-${day}`;
        }
        function normalizeDate(value) {
          const raw = String(value || "").trim();
          if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw;
          const match = raw.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);
          return match ? `${match[3]}-${String(match[2]).padStart(2, "0")}-${String(match[1]).padStart(2, "0")}` : raw;
        }
        function normalizeTime(value) {
          const match = String(value || "").trim().match(/^(\d{1,2}):(\d{2})/);
          return match ? `${String(match[1]).padStart(2, "0")}:${match[2]}` : "";
        }
        function normalizeStatus(value) {
          const status = String(value || "").toLowerCase().trim();
          if (["holiday", "closed", "off", "dayoff", "วันหยุด", "หยุด"].includes(status)) return "holiday";
          if (["available", "free", "open", "ว่าง", "คิวว่าง"].includes(status)) return "available";
          return "booked";
        }
        function getDayStatus(key) {
          const day = schedule.get(key);
          const statuses = Array.from(day?.slots?.values?.() || []).map((slot) => slot.status);
          if (day?.fullHoliday || (statuses.length > 0 && statuses.every((status) => status === "holiday"))) return "holiday";
          return statuses.some((status) => status === "available") ? "available" : "booked";
        }
        function statusText(status) {
          return status === "available" ? "ว่างอยู่" : status === "holiday" ? "วันหยุด" : "เต็มแล้ว";
        }

        async function fetchSchedule() {
          try {
            const supabaseUrl = scheduleEl.dataset.supabaseUrl;
            const supabaseKey = scheduleEl.dataset.supabaseKey;
            let rows = [];
            if (supabaseUrl && supabaseKey) {
              const endpoint = `${supabaseUrl}/rest/v1/schedule_slots?select=slot_date,slot_time,status,schedule_slot_notes(customer_name)&slot_date=gte.${toKey(dates[0])}&slot_date=lte.${toKey(dates[dates.length - 1])}`;
              const response = await fetch(endpoint, { cache: "no-store", headers: { apikey: supabaseKey, Authorization: `Bearer ${supabaseKey}` } });
              if (!response.ok) throw new Error("Unable to load Supabase schedule");
              rows = await response.json();
            } else {
              if (!Papa) throw new Error("CSV parser is unavailable");
              const response = await fetch(scheduleEl.dataset.sheetUrl || "", { cache: "no-store" });
              if (!response.ok) throw new Error("Unable to load schedule");
              const csv = await response.text();
              rows = Papa.parse(csv, { header: true, skipEmptyLines: true }).data || [];
            }
            const nextSchedule = new Map();
            rows.forEach((row) => {
              const key = normalizeDate(row.slot_date || row.date || row.DATE);
              const time = normalizeTime(row.slot_time || row.start_time || row.start || row.time);
              const status = normalizeStatus(row.status);
              const relatedName = Array.isArray(row.schedule_slot_notes) ? row.schedule_slot_notes[0]?.customer_name : row.schedule_slot_notes?.customer_name;
              const customerName = String(relatedName || row.customer_name || "").trim();
              if (!key) return;
              if (!nextSchedule.has(key)) nextSchedule.set(key, { fullHoliday: false, slots: new Map() });
              const day = nextSchedule.get(key);
              if (status === "holiday" && !time) day.fullHoliday = true;
              if (time) day.slots.set(time, { status, customerName });
            });
            schedule = nextSchedule;
            if (loadingEl) loadingEl.hidden = true;
            if (errorEl) errorEl.hidden = true;
            render();
          } catch (error) {
            console.error(error);
            if (loadingEl) loadingEl.hidden = true;
            if (errorEl) errorEl.hidden = false;
            schedule = new Map();
            render();
          }
        }

        function renderDates() {
          dateStrip.innerHTML = "";
          dates.forEach((date, index) => {
            const key = toKey(date);
            const status = getDayStatus(key);
            const button = document.createElement("button");
            button.type = "button";
            button.className = `date-card ${status}${key === selectedKey ? " selected" : ""}`;
            button.setAttribute("aria-pressed", String(key === selectedKey));
            button.setAttribute("aria-label", `${index === 0 ? "วันนี้ " : ""}${date.getDate()} ${MONTH_NAMES[date.getMonth()]} สถานะ${statusText(status)}`);
            button.innerHTML = `<span class="weekday">${index === 0 ? "วันนี้" : DAY_NAMES[date.getDay()]}</span><strong>${date.getDate()}</strong><span class="month">${MONTH_NAMES[date.getMonth()]}</span><i></i>`;
            button.addEventListener("click", () => {
              selectedKey = key;
              render();
              dateStrip.querySelector(".selected")?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
            });
            dateStrip.appendChild(button);
          });
        }

        function renderSlots() {
          const date = dates.find((item) => toKey(item) === selectedKey) || dates[0];
          const day = schedule.get(selectedKey);
          const dayStatus = getDayStatus(selectedKey);
          selectedDateEl.textContent = `${DAY_NAMES[date.getDay()]} ${date.getDate()} ${MONTH_NAMES[date.getMonth()]} ${date.getFullYear() + 543}`;
          selectedStatusEl.className = `day-status ${dayStatus}`;
          selectedStatusEl.textContent = statusText(dayStatus);
          slotGrid.innerHTML = "";
          const daySlots = Array.from(day?.slots?.entries?.() || []).sort((a, b) => a[0].localeCompare(b[0]));
          TIMES.forEach((defaultTime, index) => {
            const [time, slotData] = daySlots[index] || [defaultTime, { status: "booked", customerName: "" }];
            const storedStatus = slotData.status;
            const status = day?.fullHoliday ? "holiday" : storedStatus === "available" ? "available" : storedStatus === "holiday" ? "holiday" : "booked";
            const customerName = status === "booked" ? slotData.customerName : "";
            const item = document.createElement("article");
            item.className = `slot-card ${status}`;
            const customer = customerName ? `<small class="customer-name">คุณ ${escapeHtml(customerName)}</small>` : "";
            item.innerHTML = `<div><span>รอบที่ ${index + 1}</span><strong>${time}</strong>${customer}</div><p><i></i>${statusText(status)}</p>`;
            slotGrid.appendChild(item);
          });
        }

        function escapeHtml(value) {
          return String(value).replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character]);
        }

        function render() { renderDates(); renderSlots(); }
        document.getElementById("date-prev")?.addEventListener("click", () => dateStrip.scrollBy({ left: -420, behavior: "smooth" }));
        document.getElementById("date-next")?.addEventListener("click", () => dateStrip.scrollBy({ left: 420, behavior: "smooth" }));
        render();
        fetchSchedule();
        setInterval(fetchSchedule, 7 * 60 * 1000);
      });
    </script>
  </body>
</html>

<style is:global>
  :root { --ink:#30292c; --plum:#765463; --wine:#694553; --paper:#f9f5f4; --blush:#efe3e5; --line:#ddd3d4; --muted:#746b6e; --green:#5d8a6a; --green-bg:#e7f0e9; --red:#a55d65; --red-bg:#f2e6e8; --gold:#b88943; --gold-bg:#f5eddf; --gray-bg:#eee9ea; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--paper); color:var(--ink); font-family:"IBM Plex Sans Thai",sans-serif; font-weight:300; line-height:1.65; }
  a { color:inherit; text-decoration:none; } img { display:block; width:100%; } h1,h2,h3,p { margin-top:0; }
  h1,h2,h3,.brand { font-family:"Pridi",serif; font-weight:500; }
  .site-header { height:82px; display:flex; align-items:center; justify-content:space-between; padding:0 clamp(24px,6vw,92px); border-bottom:1px solid rgba(105,69,83,.1); background:rgba(249,245,244,.95); }
  .brand { display:flex; align-items:center; gap:12px; font-size:1.1rem; } .brand img { width:34px; height:34px; border-radius:50%; object-fit:cover; filter:grayscale(1); } .brand i { color:var(--plum); font-style:normal; }
  .back-link { color:var(--plum); font-size:.7rem; font-weight:600; text-transform:uppercase; letter-spacing:.12em; }
  .intro { padding:55px clamp(24px,7vw,110px); border-bottom:1px solid var(--line); }
  .eyebrow { color:var(--plum); font-size:.62rem; font-weight:600; letter-spacing:.22em; text-transform:uppercase; margin-bottom:16px; }
  .intro h1 { color:white; font-size:clamp(3rem,6vw,5.5rem); line-height:.98; letter-spacing:-.04em; margin-bottom:28px; } .intro h1 em { color:#ead5dc; font-weight:400; }
  .intro-copy { max-width:600px; color:#eadfe2; font-size:1rem; }
  .queue-layout { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(300px,.65fr); gap:42px; padding:80px clamp(24px,7vw,110px) 100px; align-items:start; }
  .calendar-panel { min-width:0; }
  .panel-heading { display:flex; justify-content:space-between; align-items:end; gap:30px; margin-bottom:25px; }
  .panel-heading .eyebrow { margin-bottom:8px; } .panel-heading h2 { font-size:2.2rem; margin:0; }
  .legend { display:flex; gap:18px; padding-bottom:6px; color:var(--muted); font-size:.72rem; white-space:nowrap; }
  .legend span { display:flex; align-items:center; gap:7px; } .dot { width:8px; height:8px; border-radius:50%; } .dot.available { background:var(--green); } .dot.booked { background:var(--red); } .dot.holiday { background:var(--gold); }
  .notice { display:flex; gap:14px; align-items:flex-start; padding:15px 18px; margin-bottom:18px; background:var(--blush); color:var(--muted); font-size:.76rem; }
  .notice>span { flex:0 0 auto; display:grid; place-items:center; width:22px; height:22px; border:1px solid var(--plum); border-radius:50%; color:var(--plum); font-weight:600; }
  .notice p { margin:0; } .notice strong { color:var(--ink); }
  .schedule { padding:24px; background:#fffdfc; border:1px solid var(--line); }
  .date-nav { display:grid; grid-template-columns:38px minmax(0,1fr) 38px; gap:10px; align-items:stretch; }
  .date-nav>button { border:1px solid var(--line); background:#faf7f7; color:var(--plum); cursor:pointer; font-size:1rem; transition:.2s; }
  .date-nav>button:hover { border-color:var(--plum); background:#f3ebed; }
  .date-strip { display:flex; gap:9px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; padding:0 1px 5px; }
  .date-strip::-webkit-scrollbar { display:none; }
  .date-card { position:relative; flex:0 0 78px; height:105px; border:1px solid var(--line); border-radius:10px; background:#fffdfc; color:var(--ink); display:flex; flex-direction:column; align-items:center; justify-content:center; scroll-snap-align:center; cursor:pointer; transition:.2s; }
