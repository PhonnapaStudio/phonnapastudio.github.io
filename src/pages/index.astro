---
import "../styles/fonts.css";
import SiteFooter from "../components/SiteFooter.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import SocialIcon from "../components/SocialIcon.astro";
import OptimizedPicture from "../components/OptimizedPicture.astro";
import FontPreloads from "../components/FontPreloads.astro";
import SecurityMeta from "../components/SecurityMeta.astro";
import assets from "../data/assets.generated.json";

const nailServices = [
  ["ทาเจลสีพื้น", "159 – 189 บาท"],
  ["ทาเจลกลิตเตอร์", "189 – 199 บาท"],
  ["ทาเจลลูกแก้ว / สีผง", "199 – 229 บาท"],
  ["งานฝังอะไหล่", "เริ่มต้น 10 บาท/นิ้ว"],
  ["งานเพ้นท์", "เริ่มต้น 10 บาท/นิ้ว"],
  ["งานปั้นนูน", "เริ่มต้น 10 บาท/นิ้ว"],
  ["เสริมหน้าเล็บ", "59 บาท"],
  ["ต่อเล็บ PVC (กาวเจล)", "129 บาท"],
  ["ต่อเล็บ PVC (เจนโคนกาวเจล) — ราคาโปร", "159 บาท"],
  ["ถอดเล็บ PVC / เจลเสริม", "119 บาท"],
  ["ถอดเล็บ PVC / เจลเสริม เมื่อทำจากที่ร้าน", "69 บาท"],
  ["ล้างสีเจลโดยเครื่องเจีย", "39 บาท"],
  ["ล้างสีเจลโดยเครื่องเจีย เมื่อทำจากที่ร้าน", "ฟรี"],
  ["ล้างสีเจลโดยเครื่องเจีย + น้ำยา", "59 บาท"],
  ["CUTICLE REMOVE", "139 – 239 บาท"],
  ["MINI HAND SPA 5 ขั้นตอน", "189 บาท"],
  ["MINI FOOT SPA 6 ขั้นตอน", "289 บาท"],
];

const eyelashServices = [["ลิฟต์ขนตา", "259 บาท"], ["ลิฟต์ขนคิ้ว", "89 บาท"]];
const serviceSlugs = ["solid-gel", "glitter-gel", "cat-eye-gel", "nail-charms", "nail-art", "sculpted-art", "overlay", "pvc-extension", "pvc-extension-promo", "extension-removal", "extension-removal-shop", "gel-removal", "gel-removal-shop", "gel-removal-soak", "cuticle-remove", "mini-hand-spa", "mini-foot-spa"];
const serviceIconNames = ["palette", "sparkles", "gem", "jewel", "brush", "flower", "shield", "plus", "plus", "scissors", "scissors", "eraser", "refresh", "droplets", "shield", "spa", "spa"];
const serviceIconPaths = {
  palette: '<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2a10 10 0 0 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.6-1.4-.4-.4-.6-.9-.6-1.4a2 2 0 0 1 2-2H17a5 5 0 0 0 5-5C22 5.7 17.5 2 12 2Z"/>',
  sparkles: '<path d="m12 3-1.7 3.7L6.5 8.5l3.8 1.8L12 14l1.7-3.7 3.8-1.8-3.8-1.8Z"/><path d="m5 15-.9 2.1L2 18l2.1.9L5 21l.9-2.1L8 18l-2.1-.9Z"/><path d="m19 13-.9 2.1L16 16l2.1.9L19 19l.9-2.1L22 16l-2.1-.9Z"/>',
  gem: '<path d="M6 3h12l4 6-10 12L2 9Z"/><path d="m2 9 10 4 10-4M8 3l-2 6 6 4 6-4-2-6"/>',
  jewel: '<path d="M12 3 4 8v8l8 5 8-5V8Z"/><path d="m4 8 8 5 8-5M12 13v8"/>',
  brush: '<path d="m14.6 17.9-10.7-2.9"/><path d="M18.4 2.6a1 1 0 0 1 3 3l-9.1 9.1-4.2-.7-.7-4.2Z"/><path d="M3.3 14.8c-2 2-2.2 4.1-1.4 5.4.9 1.4 3.4 1.1 5.4-.9 1.1-1.1 1.7-2.4 1.7-3.5"/>',
  flower: '<path d="M12 5a3 3 0 1 0-5.8 1 3 3 0 1 0-1.6 5.5 3 3 0 1 0 4.2 4.2 3 3 0 1 0 6.4 0 3 3 0 1 0 4.2-4.2A3 3 0 1 0 17.8 6 3 3 0 1 0 12 5Z"/><circle cx="12" cy="12" r="2"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3Z"/><path d="m9 12 2 2 4-4"/>',
  plus: '<path d="M12 5v14M5 12h14"/><circle cx="12" cy="12" r="9"/>',
  scissors: '<circle cx="6" cy="7" r="3"/><circle cx="6" cy="17" r="3"/><path d="m8.7 8.3 12.3 6.2M8.7 15.7 21 9.5"/>',
  eraser: '<path d="m7 21-4-4a2.8 2.8 0 0 1 0-4L13 3a2.8 2.8 0 0 1 4 0l4 4a2.8 2.8 0 0 1 0 4L11 21Z"/><path d="m6 10 8 8M7 21h10"/>',
  refresh: '<path d="M20 6v5h-5M4 18v-5h5"/><path d="M6.1 9A7 7 0 0 1 18 6l2 5M4 13l2 5a7 7 0 0 0 11.9-3"/>',
  droplets: '<path d="M7 16.3c2.2 0 4-1.8 4-4 0-2-4-7.3-4-7.3s-4 5.3-4 7.3c0 2.2 1.8 4 4 4ZM17 21c2.2 0 4-1.8 4-4 0-2-4-7.3-4-7.3S13 15 13 17c0 2.2 1.8 4 4 4Z"/>',
  spa: '<path d="M12 22c4.4-2 7-5.4 7-9.5-3.5.2-5.8 1.5-7 3.9-1.2-2.4-3.5-3.7-7-3.9 0 4.1 2.6 7.5 7 9.5Z"/><path d="M12 16.4C8.7 14.4 7.2 11 8 6c2.1 1 3.4 2.3 4 4 1-2.8 3-4.8 6-6 .4 3.7-.3 6.7-2.2 8.8"/>',
  eye: '<path d="M2.1 12a11.6 11.6 0 0 1 19.8 0 11.6 11.6 0 0 1-19.8 0Z"/><circle cx="12" cy="12" r="3"/>',
};
const services = [
  ...nailServices.map(([name, price], index) => ({ slug: serviceSlugs[index], name, price, category: index < 7 ? "NAIL ART" : index < 14 ? "EXTENSION & REMOVAL" : "NAIL CARE", icon: serviceIconNames[index] })),
  ...eyelashServices.map(([name, price], index) => ({ slug: index === 0 ? "lash-lift" : "brow-lift", name, price, category: "LASH & BROW", icon: "eye" })),
];
const publicSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || "";
const publicSupabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";
const portfolio = assets.portfolio;
const heroVideos = [
  "/video/SaveClip.App_AQNqS_XEv22UP5aiTs3OpjgbQ8S2j9cQEamkTs4qLTm-Erqoz9RpSjbJU88-YOCGec0oJn1vYFBXu7ZRuCuIMZLF.mp4",
  "/video/SaveClip.App_AQOYelWCJCAsQdHdojySn6B_TGRXX7Xzd6VGJbSMuSAtYLV2GWiRuIQPY02A9LTGZk9f6_-Lvt70JPzK1iDvoBiQJs24AmMmUmZ4c1Y.mp4",
];
const heroMobileVideos = [
  "/video/hero-mobile-01-v1.mp4",
  "/video/hero-mobile-02-v1.mp4",
];
const heroPoster = portfolio.find((asset) => asset.original.includes("468659143")) || portfolio[0];
const socialImage = "https://phonnapastudio.github.io/images/generated/v1/portfolio-24-242c288308-960.webp";
const studio = assets.studio;
const reviews = [
  { quote: "พูดจาดีน่ารักมากค่ะ ราคาดีมากจริง ๆ สำหรับนักศึกษา สวยด้วย เลิฟเลย", name: "BAIMON CHONTICHA" },
  { quote: "เล็บสวยถูกใจ แม่ค้าน่ารัก บริการดีมาก งานละเอียดและเป็นกันเอง", name: "BUSSARA DAUNGJONG" },
  { quote: "สวยมากค่ะ ชอบมาก บริการดีและกันเองสุด ๆ กลับมาใช้บริการอีกแน่นอน", name: "ญาณิศา ตรีสุโท" },
];
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SecurityMeta />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <FontPreloads />
    <GoogleAnalytics />
    <title>ร้านทำเล็บคลองหก คลอง 6 ใกล้ราชมงคลธัญบุรี | Phonnapa Studio</title>
    <meta name="description" content="Phonnapa Studio ร้านทำเล็บคลองหก คลอง 6 ใกล้สะพานชมพูและมหาวิทยาลัยราชมงคลธัญบุรี บริการทำเล็บเจล เพ้นท์เล็บ ต่อเล็บ PVC สปามือเท้า และลิฟต์ขนตา ราคานักศึกษา เปิดทุกวัน" />
    <meta name="keywords" content="ร้านทำเล็บคลองหก, ร้านทำเล็บคลอง 6, ทำเล็บใกล้ราชมงคลธัญบุรี, ร้านทำเล็บใกล้ฉัน, เล็บเจลคลองหก, ร้านทำเล็บสะพานชมพู, ต่อเล็บ PVC, เพ้นท์เล็บราคานักศึกษา" />
    <meta name="author" content="Phonnapa Studio" />
    <meta name="application-name" content="Phonnapa Studio" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="w60tMNbkFtNA_XxIlE1bvUxK2uz-3dqiG_3JbI13wpI" />
    <link rel="canonical" href="https://phonnapastudio.github.io/" />
    <link rel="sitemap" href="/mainmap-index.xml" />
    <link rel="icon" href={assets.logo.sources.webp[0].src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ร้านทำเล็บคลองหก ใกล้ราชมงคลธัญบุรี | Phonnapa Studio" />
    <meta property="og:description" content="เล็บสวย งานละเอียด ราคานักศึกษา ที่ Phonnapa Studio คลองหก" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="960" />
    <meta property="og:image:height" content="960" />
    <meta property="og:image:alt" content="ผลงานทำเล็บโดย Phonnapa Studio ร้านทำเล็บคลองหก" />
    <meta property="og:url" content="https://phonnapastudio.github.io/" />
    <meta property="og:site_name" content="Phonnapa Studio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ร้านทำเล็บคลองหก ใกล้ราชมงคลธัญบุรี | Phonnapa Studio" />
    <meta name="twitter:description" content="ทำเล็บเจล ต่อเล็บ PVC และเพ้นท์เล็บ ราคานักศึกษา ใกล้สะพานชมพู คลอง 6" />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#home" aria-label="Phonnapa Studio หน้าหลัก">
        <OptimizedPicture asset={assets.logo} alt="โลโก้ Phonnapa Studio" sizes="34px" loading="eager" fetchpriority="low" />
        <span>Phonnapa <i>Studio</i></span>
      </a>
      <nav class="desktop-nav" aria-label="เมนูหลัก">
        <a href="#services">บริการ</a><a href="#portfolio">ผลงาน</a><a href="#reviews">รีวิว</a><a href="/queue/">คิวว่าง</a><a href="#contact">ติดต่อ</a>
      </nav>
      <a class="header-cta" href="https://line.me/ti/p/@153nuymp" target="_blank" rel="noopener">จองคิว</a>
      <button class="menu-toggle" aria-label="เปิดเมนู" aria-expanded="false"><span></span><span></span></button>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-copy">
          <p class="eyebrow">NAIL & BEAUTY STUDIO — คลองหก</p>
          <h1><span>ร้านทำเล็บคลองหก</span><em>เล็บสวยในแบบที่เป็นคุณ</em></h1>
          <p class="lead">ร้านทำเล็บคลอง 6 ใกล้ มทร.ธัญบุรีและสะพานชมพู งานละเอียดโดยช่างประสบการณ์ พร้อมบริการครบในราคาที่เป็นมิตรกับนักศึกษา</p>
          <div class="hero-actions">
            <a class="button button-solid" href="https://line.me/ti/p/@153nuymp" target="_blank" rel="noopener">จองคิวผ่าน LINE <span>↗</span></a>
            <a class="button button-queue" href="/queue/">เช็กคิวว่าง <span>→</span></a>
            <a class="button button-ghost" href="#portfolio">ชมผลงาน</a>
          </div>
          <dl class="facts">
            <div><dt>5+</dt><dd>ปีแห่งประสบการณ์</dd></div>
            <div><dt>Clean</dt><dd>สะอาด ปลอดภัย</dd></div>
            <div><dt>RMUTT</dt><dd>ใกล้ราชมงคลธัญบุรี</dd></div>
          </dl>
        </div>
        <div class="hero-visual">
          <OptimizedPicture asset={heroPoster} class="hero-poster" alt="ผลงานทำเล็บของ Phonnapa Studio" sizes="(max-width: 900px) 100vw, 48vw" loading="eager" fetchpriority="low" />
          <video id="hero-video" autoplay muted playsinline preload="none" aria-hidden="true" tabindex="-1" data-videos={JSON.stringify(heroVideos)} data-mobile-videos={JSON.stringify(heroMobileVideos)}></video>
          <div class="rating-card"><strong>98%</strong><span>ลูกค้าบอกต่อ<br />และกลับมาใช้บริการซ้ำ</span></div>
        </div>
      </section>

      <section class="section services" id="services">
        <div class="section-heading split-heading reveal">
          <div><p class="eyebrow">OUR SERVICES</p><h2>บริการความงาม<br />ที่คัดสรรเพื่อคุณ</h2></div>
          <div class="heading-action"><p>เลือกใช้ผลิตภัณฑ์คุณภาพ ใส่ใจความสะอาด และดูแลทุกขั้นตอนอย่างพิถีพิถัน ตั้งแต่งานสีเรียบหรูไปจนถึงลายเพ้นท์เฉพาะตัว</p><button class="text-toggle" type="button" data-toggle="services-grid" data-more="ดูบริการทั้งหมด" data-less="ดูน้อยลง" aria-expanded="false">ดูบริการทั้งหมด <span>＋</span></button></div>
        </div>
        <div class="service-grid" id="services-grid" data-supabase-url={publicSupabaseUrl} data-supabase-key={publicSupabaseKey}>
          {services.map((service, i) => (
            <article class="service-card reveal" hidden={i >= 6} data-extra={i >= 6 ? "true" : undefined} data-service-slug={service.slug}>
              <svg class="service-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={serviceIconPaths[service.icon]}></svg>
              <h3>{service.name}</h3>
              <p>{service.category === "NAIL ART" ? "งานละเอียด เลือกสีและดีไซน์ให้เหมาะกับสไตล์ของคุณ" : service.category === "EXTENSION & REMOVAL" ? "ดูแลทรงเล็บและหน้าเล็บอย่างพิถีพิถันทุกขั้นตอน" : service.category === "NAIL CARE" ? "บำรุงและดูแลเล็บมือ–เท้าให้สะอาดและสุขภาพดี" : "เพิ่มความโค้งสวยเป็นธรรมชาติให้ขนตาและคิ้ว"}</p>
              <div><span>{service.category}</span><strong class="service-price">{service.price}</strong></div>
            </article>
          ))}
        </div>
        <div class="mobile-toggle-wrap"><button class="button button-ghost section-toggle" type="button" data-toggle="services-grid" data-more="ดูบริการทั้งหมด" data-less="ดูน้อยลง" aria-expanded="false">ดูบริการทั้งหมด <span>＋</span></button></div>
      </section>

      <section class="section portfolio" id="portfolio">
        <div class="portfolio-heading reveal"><div><p class="eyebrow">SELECTED WORK</p><h2>ผลงานของเรา</h2><p>รวมผลงานจริงจากลูกค้าของ Phonnapa Studio</p></div><button class="text-toggle portfolio-toggle" type="button" data-toggle="portfolio-grid" data-more="ดูภาพทั้งหมด" data-less="ดูน้อยลง" aria-expanded="false">ดูภาพทั้งหมด <span>＋</span></button></div>
        <div class="portfolio-grid" id="portfolio-grid">
          {portfolio.map((asset, i) => <figure class="work reveal" hidden={i >= 6} data-extra={i >= 6 ? "true" : undefined}><OptimizedPicture asset={asset} alt={`ผลงานทำเล็บจริงจาก Phonnapa Studio แบบที่ ${i + 1}`} sizes="(max-width: 520px) calc(50vw - 29px), (max-width: 900px) calc(50vw - 32px), calc((100vw - 248px) / 3)" loading="lazy" /></figure>)}
        </div>
        <div class="mobile-toggle-wrap"><button class="button button-ghost section-toggle" type="button" data-toggle="portfolio-grid" data-more="ดูภาพทั้งหมด" data-less="ดูน้อยลง" aria-expanded="false">ดูภาพทั้งหมด <span>＋</span></button></div>
      </section>

      <section class="promo" id="promotions">
        <div class="promo-copy reveal"><p class="eyebrow light">NEW CLIENT SPECIAL</p><h2>ลูกค้าใหม่ รับส่วนลด 50 บาท</h2><p>เพิ่มเพื่อน LINE วันนี้ และแสดงหน้าจอที่หน้าร้านเพื่อรับสิทธิ์ พร้อมติดตามคิวว่างและโปรโมชั่นใหม่ก่อนใคร</p><a href="https://line.me/ti/p/@153nuymp" target="_blank" rel="noopener">เพิ่มเพื่อนใน LINE <span>↗</span></a></div>
        <OptimizedPicture asset={assets.promo} alt="บรรยากาศพิเศษสำหรับลูกค้าใหม่ของ Phonnapa Studio" sizes="(max-width: 900px) calc(100vw - 50px), 38vw" loading="lazy" />
      </section>

      <section class="section studio" id="studio">
        <div class="studio-copy reveal">
          <p class="eyebrow">THE STUDIO</p><h2>ประสบการณ์ที่<br />Phonnapa Studio</h2>
          <p>สตูดิโอทำเล็บบรรยากาศเป็นส่วนตัวในคลองหก ออกแบบให้ผ่อนคลาย สะอาด และเดินทางสะดวกจากมหาวิทยาลัยราชมงคลธัญบุรี</p>
          <ul><li><b>♡</b><span><strong>ดูแลเหมือนคนพิเศษ</strong>ใส่ใจรายละเอียดทุกนิ้ว ทุกลาย และทุกความต้องการ</span></li><li><b>✦</b><span><strong>สะอาดและเป็นส่วนตัว</strong>อุปกรณ์ผ่านการดูแล บริการทีละเคส ไม่เร่งงาน</span></li></ul>
        </div>
        <div class="studio-gallery reveal">{studio.map((asset, i) => <OptimizedPicture asset={asset} class={`studio-${i + 1}`} alt={`บรรยากาศร้าน Phonnapa Studio ${i + 1}`} sizes="(max-width: 900px) 34vw, 18vw" loading="lazy" />)}</div>
      </section>

      <section class="section reviews" id="reviews">
        <div class="section-heading centered reveal"><p class="eyebrow">TESTIMONIALS</p><h2>เสียงจากลูกค้าของเรา</h2></div>
        <div class="review-grid">
          {reviews.map((review) => <blockquote class="reveal"><div class="stars">★★★★★</div><p>“{review.quote}”</p><cite>— {review.name}</cite></blockquote>)}
        </div>
      </section>

      <section class="section contact" id="contact">
        <div class="contact-info reveal">
