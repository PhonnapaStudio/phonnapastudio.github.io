    <script>
      const toggle = document.querySelector('.menu-toggle');
      const menu = document.querySelector('.mobile-menu');
      toggle?.addEventListener('click', () => { const open = menu?.classList.toggle('open'); toggle.setAttribute('aria-expanded', String(Boolean(open))); });
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.classList.remove('open')));
      const observer = 'IntersectionObserver' in window
        ? new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('shown'); observer.unobserve(entry.target); } }), { threshold: .12 })
        : null;
      document.querySelectorAll('.reveal').forEach(el => observer ? observer.observe(el) : el.classList.add('shown'));
      const runWhenIdle = (callback, timeout = 2000) => {
        if ('requestIdleCallback' in window) window.requestIdleCallback(callback, { timeout });
        else window.setTimeout(callback, Math.min(timeout, 600));
      };
      const afterLoad = (callback) => {
        if (document.readyState === 'complete') callback();
        else window.addEventListener('load', callback, { once: true });
      };
      const serviceGrid = document.getElementById('services-grid');
      async function loadLivePrices() {
        const url = serviceGrid?.dataset.supabaseUrl;
        const key = serviceGrid?.dataset.supabaseKey;
        if (!url || !key) return;
        try {
          const response = await fetch(`${url}/rest/v1/services?select=slug,price&active=eq.true`, { headers: { apikey: key, Authorization: `Bearer ${key}` } });
          if (!response.ok) return;
          const prices = await response.json();
          prices.forEach(({ slug, price }) => {
            const label = serviceGrid.querySelector(`[data-service-slug="${CSS.escape(slug)}"] .service-price`);
            if (label) label.textContent = price;
          });
        } catch {}
      }
      async function loadPromotionPopup() {
        const url = serviceGrid?.dataset.supabaseUrl;
        const key = serviceGrid?.dataset.supabaseKey;
        if (!url || !key) return;
        try {
          const response = await fetch(`${url}/rest/v1/promotions?select=id,title,image_url,sort_order&active=eq.true&order=sort_order.asc&limit=10`, { headers: { apikey: key, Authorization: `Bearer ${key}` } });
          if (!response.ok) return;
          const promotions = await response.json();
          if (!promotions.length) return;
          const popup = document.getElementById('promotion-popup');
          const popupImage = document.getElementById('promotion-popup-image');
          const popupTitle = document.getElementById('promotion-popup-title');
          const counter = document.getElementById('promotion-counter');
          const dots = document.getElementById('promotion-dots');
          const controls = popup.querySelector('.promotion-controls');
          let activeIndex = 0;
          let closingTimer;
          const preload = source => new Promise(resolve => {
            const image = new Image();
            image.onload = image.onerror = resolve;
            image.src = source;
          });
          const applyPromotion = () => {
            const item = promotions[activeIndex];
            popupImage.src = item.image_url;
            popupImage.alt = item.title || `โปรโมชั่น Phonnapa Studio รูปที่ ${activeIndex + 1}`;
            popupTitle.textContent = item.title || 'โปรโมชั่นพิเศษ';
            counter.textContent = `${activeIndex + 1} / ${promotions.length}`;
            dots.innerHTML = promotions.map((_, index) => `<i class="${index === activeIndex ? 'active' : ''}"></i>`).join('');
          };
          const renderPromotion = async nextIndex => {
            activeIndex = nextIndex;
            popup.classList.add('is-changing');
            await preload(promotions[activeIndex].image_url);
            applyPromotion();
            window.requestAnimationFrame(() => popup.classList.remove('is-changing'));
          };
          const close = () => {
            popup.classList.remove('is-visible');
            document.documentElement.style.overflow = '';
            window.clearTimeout(closingTimer);
            closingTimer = window.setTimeout(() => { popup.hidden = true; }, 320);
          };
          document.querySelectorAll('[data-promotion-close]').forEach(button => button.addEventListener('click', close));
          document.getElementById('promotion-prev')?.addEventListener('click', () => renderPromotion((activeIndex - 1 + promotions.length) % promotions.length));
          document.getElementById('promotion-next')?.addEventListener('click', () => renderPromotion((activeIndex + 1) % promotions.length));
          window.addEventListener('keydown', event => {
            if (popup.hidden) return;
            if (event.key === 'Escape') close();
            if (event.key === 'ArrowLeft' && promotions.length > 1) renderPromotion((activeIndex - 1 + promotions.length) % promotions.length);
            if (event.key === 'ArrowRight' && promotions.length > 1) renderPromotion((activeIndex + 1) % promotions.length);
          });
          controls.hidden = promotions.length === 1;
          await preload(promotions[0].image_url);
          applyPromotion();
          popup.hidden = false;
          document.documentElement.style.overflow = 'hidden';
          window.requestAnimationFrame(() => window.requestAnimationFrame(() => popup.classList.add('is-visible')));
        } catch {}
      }
      afterLoad(() => {
        runWhenIdle(loadPromotionPopup, 1800);
        window.setTimeout(() => runWhenIdle(loadLivePrices, 2200), 600);
      });
      const heroVideo = document.getElementById('hero-video');
      if (heroVideo instanceof HTMLVideoElement) {
        const desktopVideos = JSON.parse(heroVideo.dataset.videos || '[]');
        const mobileVideos = JSON.parse(heroVideo.dataset.mobileVideos || '[]');
        const videos = window.matchMedia('(max-width: 900px)').matches && mobileVideos.length ? mobileVideos : desktopVideos;
        let videoIndex = 0;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const saveData = Boolean(navigator.connection?.saveData);
        const startVideo = () => {
          if (!videos.length || heroVideo.dataset.started === 'true') return;
          heroVideo.dataset.started = 'true';
          heroVideo.src = videos[0];
          heroVideo.load();
          heroVideo.play().catch(() => {});
        };
        if (!reduceMotion && !saveData) {
          afterLoad(() => {
            if ('IntersectionObserver' in window) {
              const videoObserver = new IntersectionObserver(entries => {
                if (entries.some(entry => entry.isIntersecting && entry.intersectionRatio >= .35)) {
                  videoObserver.disconnect();
                  runWhenIdle(startVideo, 2500);
                }
              }, { threshold: [.35] });
              videoObserver.observe(heroVideo);
            } else {
              runWhenIdle(startVideo, 2500);
            }
          });
        }
        heroVideo.addEventListener('ended', () => {
          if (videos.length === 1) { heroVideo.currentTime = 0; heroVideo.play().catch(() => {}); return; }
          videoIndex = (videoIndex + 1) % videos.length;
          heroVideo.src = videos[videoIndex];
          heroVideo.play().catch(() => {});
        });
      }
      document.querySelectorAll('[data-toggle]').forEach(button => button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-toggle');
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        target.querySelectorAll('[data-extra="true"]').forEach(item => {
          if (item instanceof HTMLElement) {
            item.hidden = expanded;
            if (!expanded) { item.classList.add('shown'); observer?.unobserve(item); }
          }
        });
        document.querySelectorAll(`[data-toggle="${targetId}"]`).forEach(linkedButton => {
          linkedButton.setAttribute('aria-expanded', String(!expanded));
          const label = linkedButton.getAttribute(expanded ? 'data-more' : 'data-less') || '';
          linkedButton.innerHTML = `${label} <span>${expanded ? '＋' : '−'}</span>`;
        });
        if (expanded) target.closest('section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }));
    </script>
  </body>
</html>

