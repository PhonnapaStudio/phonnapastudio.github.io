<style>
  footer.shared-footer { background:#292326; color:#e7dcdf; display:grid; grid-template-columns:2fr repeat(3,1fr); gap:50px; padding:70px clamp(24px,7vw,110px) 35px; font-family:"IBM Plex Sans Thai",sans-serif; font-weight:300; line-height:1.65; }
  .shared-footer h3 { margin:0 0 12px; font-family:"IBM Plex Sans Thai",sans-serif; font-size:.62rem; font-weight:500; letter-spacing:.16em; text-transform:uppercase; color:#a58e96; }
  .shared-footer a,.shared-footer span { display:block; color:#b9aeb2; font-size:.72rem; margin:8px 0; text-decoration:none; }
  .shared-footer a { transition:color .2s; } .shared-footer a:hover { color:#fff; }
  .shared-footer a.shared-footer__social { display:flex; align-items:center; gap:8px; }
  .shared-footer__brand { display:flex; gap:15px; } .shared-footer__brand img { display:block; width:36px; height:36px; border-radius:50%; object-fit:cover; filter:grayscale(1); }
  .shared-footer__brand strong { font:500 1.1rem "Pridi",serif; } .shared-footer__brand p { margin:6px 0 0; color:#978a8f; font-size:.7rem; }
  .shared-footer small { grid-column:1/-1; border-top:1px solid #423a3e; padding-top:25px; color:#756a6e; font-size:.6rem; }
  @media (max-width:900px) { footer.shared-footer { grid-template-columns:1fr 1fr; } .shared-footer__brand { grid-column:1/-1; } }
  @media (max-width:520px) { footer.shared-footer { grid-template-columns:1fr; gap:25px; padding-bottom:85px; } .shared-footer__brand,.shared-footer small { grid-column:auto; } }
</style>
