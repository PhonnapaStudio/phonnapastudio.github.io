---
interface Props { name: "line" | "instagram"; }
const { name } = Astro.props;
---

{name === "line" ? (
  <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path fill="currentColor" d="M12 2.8c-5.5 0-10 3.7-10 8.3 0 4.1 3.6 7.4 8.4 8.1.4.1.9.2 1 .6l-.2 1.5c-.1.5.4.8.8.5l2.5-1.7c.3-.2.6-.3 1-.4 3.9-1.1 6.5-4.2 6.5-8 0-4.6-4.5-8.3-10-8.3Z" />
    <path fill="none" stroke="white" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" d="M6.7 9.1v4h2.1m1-4v4m1.5 0v-4l2.3 4v-4m4 0h-2.2v4h2.2m-2.2-2h1.8" />
  </svg>
) : (
  <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4.2" />
    <circle cx="17.4" cy="6.7" r="1" fill="currentColor" stroke="none" />
  </svg>
)}

<style>
  .social-icon { display:block; width:1.35em; height:1.35em; flex:0 0 auto; }
</style>
